#!/usr/bin/env node

"use strict";

const { execFileSync } = require("child_process");
const path = require("path");

const PLATFORMS = {
  "darwin-arm64": "@sheeki03/tirith-darwin-arm64",
  "darwin-x64": "@sheeki03/tirith-darwin-x64",
  "linux-x64": "@sheeki03/tirith-linux-x64",
  "linux-arm64": "@sheeki03/tirith-linux-arm64",
  "win32-x64": "@sheeki03/tirith-win32-x64",
};

const key = `${process.platform}-${process.arch}`;
const pkg = PLATFORMS[key];

if (!pkg) {
  console.error(
    `Unsupported platform: ${key}. Supported: ${Object.keys(PLATFORMS).join(", ")}`
  );
  process.exit(1);
}

// The published Linux npm packages contain GNU executables. A Linux kernel
// alone does not prove the glibc runtime they require (for example on Alpine).
if (process.platform === "linux") {
  let glibc;
  let runtimeReportAvailable = false;
  try {
    const reporting = process.report;
    if (typeof reporting.excludeNetwork !== "boolean") {
      throw new Error("network-free runtime reporting is unavailable");
    }
    const previousExcludeNetwork = reporting.excludeNetwork;
    try {
      reporting.excludeNetwork = true;
      if (reporting.excludeNetwork !== true) {
        throw new Error("network-free runtime reporting is unavailable");
      }
      const report = reporting.getReport();
      if (!report || !report.header || typeof report.header !== "object") {
        throw new Error("runtime report is malformed");
      }
      glibc = report.header.glibcVersionRuntime;
      runtimeReportAvailable = true;
    } finally {
      reporting.excludeNetwork = previousExcludeNetwork;
    }
  } catch {
    // Older Node or unavailable runtime facts remain unknown, not GNU.
    glibc = undefined;
    runtimeReportAvailable = false;
  }
  if (typeof glibc !== "string" || !/^\d+\.\d+(?:\.\d+)?$/.test(glibc)) {
    const reason = runtimeReportAvailable
      ? "The runtime report does not identify glibc (for example on musl/Alpine). "
      : "Node could not provide a network-free runtime report. Use Node 20.13+ (20.x) or 22+ with reporting enabled to identify this libc. ";
    console.error(
      "The published Linux npm packages require glibc. " + reason +
        "Use a compatible release or package channel, or build from source with cargo install tirith. " +
        "A user installation does not require administrator privileges."
    );
    process.exit(1);
  }
}

let binPath;
try {
  const pkgDir = path.dirname(require.resolve(`${pkg}/package.json`));
  const exe = process.platform === "win32" ? "tirith.exe" : "tirith";
  binPath = path.join(pkgDir, "bin", exe);
} catch (e) {
  console.error(
    `Could not find package ${pkg}. Make sure it was installed as an optional dependency.\n` +
      `Try: npm install tirith --force`
  );
  process.exit(1);
}

try {
  execFileSync(binPath, process.argv.slice(2), { stdio: "inherit" });
} catch (e) {
  if (typeof e.status === "number") {
    process.exit(e.status);
  }
  if (e.signal) {
    // execFileSync reports a signalled child with status=null. Passing null to
    // process.exit would turn a crash or interruption into successful exit 0.
    // Preserve the signal for calling shells, with a failure fallback on
    // platforms that cannot deliver that signal to the launcher.
    process.exitCode = 1;
    try {
      process.kill(process.pid, e.signal);
    } catch {
      process.exit(1);
    }
  } else {
    throw e;
  }
}
