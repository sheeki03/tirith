+                assert!(crate::Cli::try_parse_from(["tirith", "menu", "--json"]).is_err());
+                assert!(matches!(
+                    crate::Cli::try_parse_from(["tirith", "status", "--json"])
+                        .unwrap()
+                        .command,
+                    Commands::Status { json: true, .. }
+                ));
+                let help = crate::Cli::try_parse_from(["tirith", "menu", "--help"])
